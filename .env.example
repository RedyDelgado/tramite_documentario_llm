APP_NAME="Trámite Documentario"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Puerto publicado por nginx en 127.0.0.1 (el 8090 y el 5173 los usa academico_web).
APP_PORT=8100
APP_URL=http://localhost:8100
APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tramite
DB_USERNAME=tramite
DB_PASSWORD=cambiar-esta-clave

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=cambiar-esta-clave
REDIS_PORT=6379

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
# Mínimo 16 bytes; Meilisearch no arranca en producción con una clave débil.
MEILISEARCH_KEY=cambiar-esta-clave-maestra

# Servicio de IA: solo en la red interna de Docker.
AI_SERVICE_URL=http://ai:8000
AI_SERVICE_TOKEN=cambiar-este-token

# Sin SSR: app interna, el renderizado en cliente basta.
INERTIA_SSR_ENABLED=false

# Superadmin inicial que crea el seeder (ingresará con Google en la fase 2).
SUPERADMIN_NAME="Administrador del sistema"
SUPERADMIN_EMAIL=admin@example.com

# Puerto del servidor de Vite (solo desarrollo).
VITE_PORT=5174

MAIL_MAILER=log
MAIL_FROM_ADDRESS="tramite@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
