APP_NAME="Trámite Documentario"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Puerto publicado por nginx en 127.0.0.1 (el 8090 y el 5173 los usa academico_web).
APP_PORT=8100
APP_URL=http://localhost:8100
APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tramite
# Rol de la aplicación. Con DB_DUENO_* definidos, db:actualizar lo crea sin permiso para alterar la auditoría.
DB_USERNAME=tramite
DB_PASSWORD=cambiar-esta-clave
# Dueño de las tablas (superusuario de PostgreSQL): migra y respalda. Vacío, es el mismo rol de arriba.
# DB_DUENO_USERNAME=tramite
# DB_DUENO_PASSWORD=cambiar-esta-otra-clave

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=cambiar-esta-clave
REDIS_PORT=6379

SCOUT_DRIVER=meilisearch
# Indexación en cola (Horizon): ingresar un correo no espera a Meilisearch.
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://meilisearch:7700
# Mínimo 16 bytes; Meilisearch no arranca en producción con una clave débil.
MEILISEARCH_KEY=cambiar-esta-clave-maestra

# Servicio de IA: solo en la red interna de Docker.
AI_SERVICE_URL=http://ai:8000
AI_SERVICE_TOKEN=cambiar-este-token

# Sin SSR: app interna, el renderizado en cliente basta.
INERTIA_SSR_ENABLED=false

# Buzón central (7.1). El job programado solo corre con CORREO_ACTIVO=true; el buzón real exige
# autorización escrita (pendiente 1). En desarrollo, CORREO_DRIVER=directorio lee .eml de una carpeta.
CORREO_ACTIVO=false
CORREO_DRIVER=directorio
CORREO_BACKFILL_DESDE=2026-01-01
# Lo recibido antes de esta fecha entra como histórico (sin semáforo ni avisos).
CORREO_INICIO_OPERACION=
CORREO_LOTE=50
# Solo con CORREO_DRIVER=gmail; cómo obtenerlos en docs/runbook-gmail.md.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ETIQUETA=tramite/procesado

# Documentos salientes (7.3.4): gmail envía desde el buzón central con el mismo token; mailer usa MAIL_MAILER.
SALIENTES_DRIVER=mailer
SALIENTES_POR_MINUTO=20
SALIENTES_BUZON_CENTRAL=

# Siguiente número de registro al poner en marcha (6.2): 2026 continúa el papel en N°00038.
REGISTRO_INICIO_ANIO=2026
REGISTRO_INICIO_NUMERO=38

# Antivirus (11): con `docker compose --profile clamav up -d`, ANTIVIRUS_HOST=clamav. Vacío, no se analiza.
ANTIVIRUS_HOST=

# Respaldo diario a las 02:30 (docs/runbook-respaldos.md); copiar la carpeta fuera del servidor.
# RESPALDO_DIRECTORIO=/ruta/de/respaldos  (por defecto storage/app/respaldos)
RESPALDO_DIAS=30
# Cifra los respaldos (openssl rand -base64 32). Sin ella no se cifran; si se pierde, los respaldos no se pueden leer.
RESPALDO_CLAVE=

# Inicio de sesión con Google (docs/runbook-google-login.md). Solo entran cuentas de este dominio
# que además estén registradas y activas en el sistema.
GOOGLE_DOMINIO=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Superadmin inicial que crea el seeder; ingresa con Google, así que debe ser del dominio.
SUPERADMIN_NAME="Administrador del sistema"
SUPERADMIN_EMAIL=admin@example.com

# Producción (docs/runbook-produccion.md): COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml y DOMINIO=<nombre del servidor>.

# Puerto del servidor de Vite (solo desarrollo).
VITE_PORT=5174

# gmail en producción: el correo del sistema sale por la cuenta del buzón central (docs/runbook-produccion.md).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="tramite@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
